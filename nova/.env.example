EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_API_URL=https://threeproxy-x9bi.onrender.com
# Google OAuth Web client ID (Supabase Auth → Google provider)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional — crashes (Sentry) + product analytics (PostHog). See docs/observability.md
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EXPO_PUBLIC_APP_ENV=production

# Server only — never put these in the mobile app

# Preferred: free Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback if Groq is not set
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PORT=8787

# Google Calendar OAuth (read-only) — no Gmail API / no CASA
# Create at https://console.cloud.google.com/apis/credentials (OAuth web client)
# Enable Google Calendar API only. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://threeproxy-x9bi.onrender.com/api/email/callback
PUBLIC_API_URL=https://threeproxy-x9bi.onrender.com
PUBLIC_APP_URL=https://ramza107.github.io/3proxy/nova/
# After Google Allow on iPhone/Android, server redirects here (custom scheme)
PUBLIC_NATIVE_APP_URL=wahrly://
