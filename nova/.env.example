EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_API_URL=https://threeproxy-x9bi.onrender.com

# Server only — never put these in the mobile app

# Preferred: free Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback if Groq is not set
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PORT=8787

# Gmail OAuth — morning inbox “who wrote” digest
# Create at https://console.cloud.google.com/apis/credentials (OAuth web client)
# Enable Gmail API. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://threeproxy-x9bi.onrender.com/api/email/callback
PUBLIC_API_URL=https://threeproxy-x9bi.onrender.com
PUBLIC_APP_URL=https://ramza107.github.io/3proxy/nova/
