{
  "name": "nova",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "typecheck": "tsc --noEmit",
    "preflight:eas": "node ./scripts/preflight-eas.js",
    "build:android": "npm run preflight:eas && npx eas-cli build --platform android --profile preview",
    "build:ios": "npm run preflight:eas && npx eas-cli build --platform ios --profile preview",
    "build:mobile": "npm run preflight:eas && npx eas-cli build --platform all --profile preview",
    "build:android:prod": "npm run preflight:eas && npx eas-cli build --platform android --profile production",
    "build:ios:prod": "npm run preflight:eas && npx eas-cli build --platform ios --profile production",
    "build:ios:testflight": "npm run preflight:eas && npx eas-cli build --platform ios --profile production --auto-submit",
    "submit:ios": "npx eas-cli submit --platform ios --latest --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "typescript": "~5.9.2"
  },
  "private": true
}
