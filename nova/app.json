{
  "expo": {
    "name": "Wahrly",
    "slug": "wahrly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wahrly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E7EEF2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wahrly.assistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wahrly uses the microphone so you can dictate tasks and reminders."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E7EEF2"
      },
      "package": "com.wahrly.assistant",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Wahrly to use the microphone to dictate tasks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/3proxy/nova"
    },
    "extra": {
      "apiUrl": "https://threeproxy-x9bi.onrender.com"
    }
  }
}
